rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /messages/{messageId} {
      allow get, list: if resource.data.coupleId == 'ahmed-dalia';
      allow create: if request.resource.data.keys().hasAll(['coupleId', 'name', 'relation', 'message', 'createdAt'])
        && request.resource.data.keys().hasOnly(['coupleId', 'name', 'relation', 'message', 'createdAt'])
        && request.resource.data.coupleId == 'ahmed-dalia'
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.relation is string
        && request.resource.data.relation.size() <= 60
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 400
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
